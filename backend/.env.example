# 이 파일을 복사해 같은 폴더에 .env 로 만들고 모든 값을 채운다. (.env는 깃에 올라가지 않음)
# 주의: "KEY=" 처럼 빈 값으로 두면 빈 문자열로 적용된다. 쓰지 않는 항목은 줄을 지운다.

# MySQL
DB_HOST=
DB_PORT=
DB_NAME=
DB_TEST_NAME=
DB_USERNAME=
DB_PASSWORD=

# Keycloak (docker-compose.yml)
KEYCLOAK_PORT=
# 관리 콘솔(master realm) 관리자 계정 — Keycloak을 처음 실행할 때 만들어진다
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=
# 백엔드 서비스 계정(enjoyyourtrip-backend) 비밀값 — 임의의 긴 문자열. 처음 실행할 때 realm에 들어간다
KEYCLOAK_BACKEND_CLIENT_SECRET=
# 백엔드가 접속할 Keycloak 주소 (KEYCLOAK_PORT와 맞춘다)
KEYCLOAK_URL=

# 최초 관리자 계정 (백엔드 시작 시 Keycloak에 없으면 만들고 ADMIN 역할을 준다)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 한국관광공사 TourAPI (공공데이터포털 KorService2) 서비스 키 — 디코딩(Decoding) 키
TOUR_API_KEY=
TOUR_API_BASE_URL=

# Redis (docker-compose.yml)
REDIS_HOST=
REDIS_PORT=
REDIS_INSIGHT_PORT=
